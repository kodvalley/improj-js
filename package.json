{
  "name": "@kodvalley/improj",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the IMPROJ public API: typed client, pagination, retries, uploads and webhook verification. Zero runtime dependencies.",
  "keywords": [
    "improj",
    "api",
    "sdk",
    "project-management",
    "webhooks",
    "typescript"
  ],
  "homepage": "https://github.com/kodvalley/improj-js#readme",
  "bugs": {
    "url": "https://github.com/kodvalley/improj-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodvalley/improj-js.git"
  },
  "license": "MIT",
  "author": "Kodvalley <dev@improj.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/esm/webhooks/web.d.ts",
        "default": "./dist/esm/webhooks/web.js"
      },
      "require": {
        "types": "./dist/cjs/webhooks/web.d.ts",
        "default": "./dist/cjs/webhooks/web.js"
      }
    },
    "./webhooks/node": {
      "import": {
        "types": "./dist/esm/webhooks/node.d.ts",
        "default": "./dist/esm/webhooks/node.js"
      },
      "require": {
        "types": "./dist/cjs/webhooks/node.d.ts",
        "default": "./dist/cjs/webhooks/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "webhooks": [
        "./dist/cjs/webhooks/web.d.ts"
      ],
      "webhooks/node": [
        "./dist/cjs/webhooks/node.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node --test smoke/esm.test.mjs smoke/cjs.test.cjs",
    "check:package": "publint --strict && attw --pack .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
